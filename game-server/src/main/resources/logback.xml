<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Console output with colors - ERROR level only, but allow INFO for GameService -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>[%d{HH:mm:ss.SSS}] %highlight(%-5level) %cyan(%logger{0}) - %msg %n</pattern>
        </encoder>
    </appender>

    <!-- File output for all logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>logs/server.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep 7 days of history -->
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] %-5level %logger{36} - %msg %n</pattern>
        </encoder>
    </appender>

    <!-- File output for ERROR and WARN only -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/errors.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/errors.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] %-5level %logger{36} - %msg%n%ex{full}</pattern>
        </encoder>
    </appender>

    <!-- Logger levels set to ERROR to suppress INFO/DEBUG messages in console -->
    <!-- Note: File appenders will still receive all logs due to root level INFO -->
    <logger name="org.alter" level="ERROR"/>
    <!-- Allow INFO level for GameService to show RAM usage heartbeat -->
    <logger name="org.alter.game.service.GameService" level="INFO"/>
    <logger name="org.gradle" level="ERROR"/>
    <logger name="net.rsprot" level="ERROR"/>
    <logger name="dev.openrune" level="ERROR"/>

    <!-- Gradle-specific logging -->
    <logger name="org.gradle.cache.internal" level="INFO"/>
    <logger name="org.gradle.internal.resources" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>
</configuration>